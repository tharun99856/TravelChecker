PORT=3001

# --- Google Maps Distance Matrix API ---
# Enable "Distance Matrix API" at: https://console.cloud.google.com/
# Free tier: 200 USD/month (~40,000 distance lookups)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- Travelpayouts / Aviasales Flights Search API ---
# Sign up at: https://travelpayouts.com/
# Token + Marker from your affiliate dashboard
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token
TRAVELPAYOUTS_MARKER=your_travelpayouts_marker
TRAVELPAYOUTS_HOST=yourdomain.com
TRAVELPAYOUTS_LOCALE=en-us
TRAVELPAYOUTS_CURRENCY=inr

# --- RapidAPI IRCTC Train API ---
# Subscribe at: https://rapidapi.com/IRCTC/api/irctc19
# Free tier: 100 requests/day
RAPIDAPI_KEY=your_rapidapi_key
